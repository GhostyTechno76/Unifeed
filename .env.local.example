# Optional: Connect Next.js dev server directly to your remote Cloudflare D1 Database & Workers AI
# (If not provided, the local server uses persistent storage in .data/d1_storage.json)

# Your Cloudflare Account ID (find it in Cloudflare Dashboard -> Workers & Pages overview)
CLOUDFLARE_ACCOUNT_ID=

# Your Cloudflare API Token (with D1 Edit & Workers AI Read permissions)
CLOUDFLARE_API_TOKEN=

# D1 Database ID from wrangler.toml
CLOUDFLARE_DATABASE_ID=2070c0ea-2662-4d50-8dc3-265e9f7b8c1b
